# Configuration variables for the Bank OCR Vision Telegram Bot.
# Rename this file to .env and fill in your actual credentials.

# 1. Your Telegram Bot Token obtained from @BotFather
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# 2. Your Gemini API Key from Google AI Studio
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# 3. Your Telegram Channel ID where extracted summaries will be forwarded.
# Use negative 13-digit numbers for private channels (e.g. -1001234567890) or @username for public channels.
OUTPUT_CHANNEL_ID=YOUR_OUTPUT_CHANNEL_ID_HERE

# 4. The Gemini Model to use for Vision analysis
GEMINI_MODEL=gemini-2.0-flash

# 5. Groq Vision API Config (100% Free alternative to Gemini)
PROVIDER=groq
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# 6. Admin User IDs (comma-separated list of Telegram User IDs allowed to configure settings via chat)
# E.g. ADMIN_USER_IDS=123456789,987654321
ADMIN_USER_IDS=YOUR_TELEGRAM_USER_ID_HERE
